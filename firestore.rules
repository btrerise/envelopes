rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only these three sign-ins can read or change anything:
    // Ben, Kim, and the account the budget sheet's script uses to sync.
    function household() {
      return request.auth != null && request.auth.token.email in [
        'bentontrerise@gmail.com',
        'kimberlee.trerise@gmail.com',
        'envelopes-sync@example.com'
      ];
    }
    match /{document=**} {
      allow read, write: if household();
    }
  }
}
